{
  "name": "code-quality-gate",
  "version": "0.6.1",
  "description": "Test-first quality gates for AI coding agents, with language-independent checks and Markdown reports",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "exports": "./src/index.mjs",
  "bin": {
    "cqg": "src/cli.mjs",
    "code-quality-gate": "src/cli.mjs",
    "code-quality": "src/cli.mjs"
  },
  "files": [
    "src",
    "skills",
    "README.md",
    "README.zh-CN.md",
    "assets",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "docs",
    "examples"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check": "node src/cli.mjs check",
    "format": "prettier --write src tests",
    "format:check": "prettier --check src tests",
    "audit": "node src/cli.mjs audit",
    "prepublishOnly": "npm test && npm run format:check && npm run check"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@typescript-eslint/parser": "8.60.1",
    "eslint": "10.12.0",
    "eslint-plugin-sonarjs": "4.2.2",
    "fast-xml-parser": "5.11.2",
    "minimatch": "10.2.4",
    "typescript": "5.9.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "prettier": "3.6.2"
  },
  "author": "ice.Sheep",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iceSheep2003/code-quality-gate.git"
  },
  "homepage": "https://github.com/iceSheep2003/code-quality-gate#readme",
  "bugs": {
    "url": "https://github.com/iceSheep2003/code-quality-gate/issues"
  },
  "keywords": [
    "ai",
    "mcp",
    "tdd",
    "quality-gate",
    "testing",
    "coverage",
    "mutation-testing",
    "cli"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
